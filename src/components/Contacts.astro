---
import { CONTACTS } from '../config';
---

<section id="contacts" class="relative overflow-hidden border-t border-gray-200/60 py-24 dark:border-gray-800/60 sm:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="bg-glow absolute -top-40 right-0 h-[400px] w-[400px] rounded-full opacity-60" />
    <div class="bg-grid absolute inset-0" />
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-500">Контакты</span>
      <h2 class="section-title mt-3">Свяжитесь со мной</h2>
      <p class="mt-3 text-base text-gray-500 dark:text-gray-400">
        Обсудим ваш проект в Telegram, по почте или телефону
      </p>
    </div>

    <div class="mt-14 mx-auto max-w-lg" data-reveal>
      <div class="card overflow-hidden">
        <div class="divide-y divide-gray-200/60 dark:divide-gray-800/60">
          <a
            href={CONTACTS.telegramDeepLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 px-6 py-5 transition-colors hover:bg-accent-50/50 dark:hover:bg-accent-950/30"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500/10 to-blue-600/10 text-blue-600 dark:from-blue-400/10 dark:to-blue-500/10 dark:text-blue-400">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium">Telegram</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 truncate">{CONTACTS.telegram}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-gray-300 dark:text-gray-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>

          <a
            href={`mailto:${CONTACTS.email}`}
            class="flex items-center gap-4 px-6 py-5 transition-colors hover:bg-accent-50/50 dark:hover:bg-accent-950/30"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-accent-500/10 to-accent-600/10 text-accent-600 dark:from-accent-400/10 dark:to-accent-500/10 dark:text-accent-400">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium">Email</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 truncate">{CONTACTS.email}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-gray-300 dark:text-gray-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>

          <a
            href={`tel:${CONTACTS.phoneRaw}`}
            class="flex items-center gap-4 px-6 py-5 transition-colors hover:bg-accent-50/50 dark:hover:bg-accent-950/30"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500/10 to-emerald-600/10 text-emerald-600 dark:from-emerald-400/10 dark:to-emerald-500/10 dark:text-emerald-400">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium">Телефон</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 truncate">{CONTACTS.phone}</p>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-gray-300 dark:text-gray-600"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <div class="mt-8 text-center" data-reveal>
        <a
          href={CONTACTS.telegramDeepLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          Написать в Telegram
        </a>
      </div>
    </div>
  </div>
</section>
