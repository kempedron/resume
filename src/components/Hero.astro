---
import { CONTACTS } from '../config';

const tg = CONTACTS.telegram;
---

<section class="relative overflow-hidden pt-32 pb-24 sm:pt-40 sm:pb-32">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="bg-glow absolute -top-40 right-0 h-[600px] w-[600px] rounded-full opacity-70" />
    <div class="bg-glow absolute -bottom-40 left-0 h-[500px] w-[500px] rounded-full opacity-50" />
    <div class="bg-grid absolute inset-0" />
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-accent-200/60 bg-accent-50/80 px-4 py-1.5 text-sm font-medium text-accent-700 backdrop-blur-sm dark:border-accent-800/60 dark:bg-accent-950/60 dark:text-accent-300">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-75" />
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-500" />
        </span>
        Доступен к сотрудничеству
      </div>

      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        <span class="block text-gray-900 dark:text-gray-100">Артем Родионов</span>
        <span class="gradient-text mt-3 block text-2xl sm:text-3xl lg:text-4xl">
          Разработчик информационных решений
        </span>
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-gray-500 dark:text-gray-400 sm:text-xl max-w-2xl mx-auto">
        Разрабатываю сайты, Telegram ботов и мини-приложения, настраиваю инфраструктуру,
        парсю данные. Помогаю бизнесу автоматизироваться и расти в интернете.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="#contacts" class="btn-primary text-sm">
          Обсудить проект
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#portfolio" class="btn-secondary text-sm">
          Смотреть работы
        </a>
        <a href={CONTACTS.telegramUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          {tg}
        </a>
      </div>

      <div class="mt-16 grid grid-cols-3 gap-6 border-y border-gray-200/60 py-6 dark:border-gray-800/60" data-reveal data-reveal-delay="2">
        <div class="text-center">
          <div class="text-2xl font-bold text-accent-500">5+</div>
          <div class="mt-1 text-xs text-gray-400">лет опыта</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-accent-500">50+</div>
          <div class="mt-1 text-xs text-gray-400">проектов</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-bold text-accent-500">100%</div>
          <div class="mt-1 text-xs text-gray-400">сдачи в срок</div>
        </div>
      </div>
    </div>
  </div>
</section>
