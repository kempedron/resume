---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../config';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section id="portfolio" class="border-t border-gray-200/60 py-24 dark:border-gray-800/60 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-500">Портфолио</span>
      <h2 class="section-title mt-3">Примеры работ</h2>
      <p class="mt-3 text-base text-gray-500 dark:text-gray-400">
        Реализованные проекты в разных направлениях
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => {
        const { title, description, category, technologies, image } = project.data;
        return (
          <a href={withBase(`/projects/${project.slug}`)} class="group card card-hover overflow-hidden p-0" data-reveal data-reveal-delay={i + 1}>
            <div class="relative aspect-[4/3] overflow-hidden bg-gray-100 dark:bg-gray-800">
              <img
                src={withBase(image)}
                alt={title}
                class="h-full w-full object-cover transition-all duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
            </div>
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-accent-500">
                {category}
              </span>
              <h3 class="mt-1.5 text-base font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400 line-clamp-2">
                {description}
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {technologies?.map((tech: string) => (
                  <span class="rounded-lg bg-gray-100 px-2.5 py-1 text-[11px] font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
