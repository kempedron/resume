---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACTS, withBase } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, category, technologies, image } = project.data;
const { Content } = await project.render();
---

<BaseLayout title={`${title} — Артем Родионов`} description={description}>
  <div class="min-h-screen">
    <div class="mx-auto max-w-4xl px-6 py-24 sm:py-32">
      <a
        href={withBase('/#portfolio')}
        class="mb-8 inline-flex items-center gap-1.5 text-sm text-gray-400 transition-colors hover:text-accent-500"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Назад к портфолио
      </a>

      {image && (
        <div class="mb-10 overflow-hidden rounded-2xl">
          <img src={withBase(image)} alt={title} class="w-full object-cover" />
        </div>
      )}

      <div data-reveal>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-500">{category}</span>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-gray-500 dark:text-gray-400">{description}</p>

        <div class="mt-6 flex flex-wrap gap-2">
          {technologies?.map((tech) => (
            <span class="rounded-lg bg-accent-50 px-3 py-1.5 text-sm font-medium text-accent-700 dark:bg-accent-950/50 dark:text-accent-300">{tech}</span>
          ))}
        </div>
      </div>

      <div class="prose prose-gray mt-12 max-w-none dark:prose-invert prose-headings:font-semibold prose-a:text-accent-500">
        <Content />
      </div>

      <div class="mt-16 border-t border-gray-200/60 pt-10 dark:border-gray-800/60" data-reveal>
        <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">Хотите такой же проект?</p>
        <a href={CONTACTS.telegramUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          Обсудить проект в Telegram
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
